{
  "name": "wayfare",
  "private": true,
  "version": "0.1.0",
  "description": "WayFare: automates the financial work of travel (Wayfinder, ReRoute, TripWallet).",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
