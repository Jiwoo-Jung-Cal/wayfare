# Copy to .env.local (never commit real values).
# --- Browser (Vite; public, non-secret) ---
# Set to use connected mode against the WayFare API server. Leave unset for sample mode.
# VITE_WAYFARE_API_URL=http://localhost:8787

# --- Server only (npm run server) ---
# PORT=8787
# WAYFARE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WAYFARE_DATA_DIR=.data            # or "memory"
# WAYFARE_SESSION_TTL_HOURS=168     # guest sessions expire this long after creation
# WAYFARE_SESSION_LIMIT_PER_HOUR=20 # new guest sessions per client IP per hour
# WAYFARE_EXTRACT_LIMIT_PER_HOUR=30 # booking extractions (paid AI calls) per workspace per hour
# WAYFARE_TRUST_PROXY=0             # 1 = use X-Forwarded-For as client IP (only behind a trusted proxy)
# WAYFARE_AI_PROVIDER=anthropic     # or "none"
# ANTHROPIC_API_KEY=                # secret; server only. WAYFARE_ANTHROPIC_API_KEY also accepted.
# WAYFARE_AI_MODEL=claude-opus-5-5
# WAYFARE_AI_EFFORT=medium
# WAYFARE_AI_TIMEOUT_MS=60000
# WAYFARE_AI_MAX_INPUT_CHARS=20000
# WAYFARE_ANTHROPIC_BASE_URL=https://api.anthropic.com
